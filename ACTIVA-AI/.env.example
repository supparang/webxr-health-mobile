DATABASE_URL="postgresql://activa:activa_password@localhost:5432/activa_ai?schema=public"
QR_SIGNING_SECRET="change-this-to-a-long-random-secret-before-real-use"
QR_TOKEN_TTL_SECONDS="45"
PORT="3000"
RESEARCH_HASH_SALT="change-this-research-salt"
RULE_VERSION="ACTIVA-RULES-0.2.0"

REVIEW_TARGET_HOURS="24"

# Comma-separated browser origins allowed to call the API.
# Example: https://supparang.github.io,https://pilot.example.org
ALLOWED_ORIGINS=""

# Authentication is fail-closed by default.
# DEMO_HEADER is for local/CI only.
# Google Workspace pilot configuration:
# ACTIVA_AUTH_MODE="GOOGLE_OIDC"
# GOOGLE_CLIENT_ID="<OAuth 2.0 Web client id>.apps.googleusercontent.com"
# GOOGLE_ALLOWED_DOMAINS="your-university.ac.th"
ACTIVA_AUTH_MODE="DISABLED"
GOOGLE_CLIENT_ID=""
GOOGLE_ALLOWED_DOMAINS=""
