DATABASE_URL="postgresql://activa:activa_password@localhost:5432/activa_ai?schema=public"
QR_SIGNING_SECRET="change-this-to-a-long-random-secret-before-real-use"
QR_TOKEN_TTL_SECONDS="45"
PORT="3000"
RESEARCH_HASH_SALT="change-this-research-salt"
RULE_VERSION="ACTIVA-RULES-0.2.0"

REVIEW_TARGET_HOURS="24"

# Comma-separated browser origins allowed to call the API.
# Example: https://supparang.github.io,https://pilot.example.org
ALLOWED_ORIGINS=""

# Authentication is fail-closed by default.
# DEMO_HEADER is for local/CI only.
# Google Workspace pilot configuration:
# ACTIVA_AUTH_MODE="GOOGLE_OIDC"
# Public OAuth client ID; never put a client secret here or in the browser.
# chandra.ac.th is provisional pending confirmation of the actual Workspace account.
# For a hosted pilot, use .env.pilot.example and docs/v1.0.15-staging-deployment.md.
ACTIVA_AUTH_MODE="DISABLED"
GOOGLE_CLIENT_ID="517090311491-u00q8g6aonuj2251ak7erqcose70gg2h.apps.googleusercontent.com"
GOOGLE_ALLOWED_DOMAINS="chandra.ac.th"
# Optional comma-separated exact Google accounts for controlled pilot exceptions.
# Keep this empty in production unless a named exception is explicitly required.
GOOGLE_ALLOWED_EMAILS=""
ACTIVA_PRODUCTION_GO_ENABLED="false"
