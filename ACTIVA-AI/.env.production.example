# ACTIVA-AI production template.
# Copy values into the production platform secret/config store; do not commit a filled copy.
NODE_ENV=production
ACTIVA_DEPLOYMENT_TIER=PRODUCTION
PORT=3000

# Private values: provision independently from staging.
DATABASE_URL=
QR_SIGNING_SECRET=
RESEARCH_HASH_SALT=

QR_TOKEN_TTL_SECONDS=45
RULE_VERSION=ACTIVA-RULES-0.2.0
REVIEW_TARGET_HOURS=24

# Exact HTTPS frontend origins only. Never use *.
ALLOWED_ORIGINS=

# Google OIDC only. Keep the organization route and any named pilot route separated.
ACTIVA_AUTH_MODE=GOOGLE_OIDC
GOOGLE_CLIENT_ID=517090311491-u00q8g6aonuj2251ak7erqcose70gg2h.apps.googleusercontent.com
GOOGLE_ALLOWED_DOMAINS=chandra.ac.th
GOOGLE_PILOT_CLIENT_ID=
GOOGLE_ALLOWED_EMAILS=

# Start false. Change to true only in the production service after the release decision
# and all production acceptance evidence have been reviewed.
ACTIVA_PRODUCTION_GO_ENABLED=false

# PHASE 4 EMPIRICAL COLLECTION: default OFF. These references belong in a PRIVATE
# operator-managed deployment config only AFTER the PI verifies the actual CRU
# ethics/site/consent authorization. An environment switch is not ethics approval.
# Leave blank/false during P4 pre-submission; QA_TEST is unaffected.
ACTIVA_EMPIRICAL_COLLECTION_ENABLED=false
ACTIVA_APPROVED_STUDY_STAGE=
ACTIVA_ETHICS_DECISION_REF=
ACTIVA_SITE_PERMISSION_REF=
ACTIVA_APPROVED_CONSENT_VERSION=
# Exact SHA-256 of approved UTF-8 consentText after operator-facing trim.
ACTIVA_APPROVED_CONSENT_TEXT_SHA256=
ACTIVA_ETHICS_VALID_FROM_UTC=
ACTIVA_ETHICS_VALID_UNTIL_UTC=
# Mandatory only for MAIN (not independently authorized FEASIBILITY) stage.
ACTIVA_SAMPLE_PLAN_SIGNOFF_REF=
