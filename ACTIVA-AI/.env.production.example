# ACTIVA-AI production template.
# Copy values into the production platform secret/config store; do not commit a filled copy.
NODE_ENV=production
ACTIVA_DEPLOYMENT_TIER=PRODUCTION
PORT=3000

# Private values: provision independently from staging.
DATABASE_URL=
QR_SIGNING_SECRET=
RESEARCH_HASH_SALT=

QR_TOKEN_TTL_SECONDS=45
RULE_VERSION=ACTIVA-RULES-0.2.0
REVIEW_TARGET_HOURS=24

# Exact HTTPS frontend origins only. Never use *.
ALLOWED_ORIGINS=

# Google OIDC only. Keep the organization route and any named pilot route separated.
ACTIVA_AUTH_MODE=GOOGLE_OIDC
GOOGLE_CLIENT_ID=517090311491-u00q8g6aonuj2251ak7erqcose70gg2h.apps.googleusercontent.com
GOOGLE_ALLOWED_DOMAINS=chandra.ac.th
GOOGLE_PILOT_CLIENT_ID=
GOOGLE_ALLOWED_EMAILS=

# Start false. Change to true only in the production service after the release decision
# and all production acceptance evidence have been reviewed.
ACTIVA_PRODUCTION_GO_ENABLED=false
