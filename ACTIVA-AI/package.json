{
  "name": "activa-ai-prototype",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "ACTIVA-AI research prototype: policy-aware multi-source participation evidence verification",
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "deployment:check": "node scripts/check-deployment.mjs",
    "staging:verify": "node scripts/verify-staging.mjs",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "db:setup": "prisma generate && prisma db push && node prisma/seed.js",
    "db:reset-demo": "prisma migrate reset --force",
    "db:push": "prisma db push",
    "test:smoke": "node tests/smoke.mjs",
    "test:auth": "node tests/auth-readiness.mjs && node tests/google-oidc.mjs",
    "test:deployment": "node tests/deployment-config.mjs && node tests/staging-verifier.mjs",
    "test:frontend-auth": "node tests/frontend-auth.mjs",
    "production:verify": "node scripts/verify-production.mjs",
    "test:production-monitor": "node tests/production-verifier.mjs",
    "recovery:verify": "node scripts/verify-recovery-database.mjs",
    "test:recovery-verifier": "node tests/recovery-verifier.mjs",
    "phase3:dataset-check": "node scripts/validate-phase3-dataset.mjs",
    "test:phase3-readiness": "node tests/phase3-dataset-readiness.mjs",
    "phase3:sample-plan": "python ml/plan_phase3_sample.py",
    "phase4:verify": "node scripts/verify-phase4-closure.mjs --manifest research/phase4-closure.json --sample-plan ml/phase3-sample-plan.json",
    "test:phase4-closure": "node tests/phase4-closure.mjs",
    "test:phase4-empirical-gate": "node tests/empirical-gate.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "google-auth-library": "^10.3.0"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
