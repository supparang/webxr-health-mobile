# Backend staging template. Store the filled copy OUTSIDE the repository.
# The three blank secrets must come from the deployment platform's secret store.
# This unquoted format is compatible with Docker --env-file and dotenv.
NODE_ENV=production
PORT=3000
DATABASE_URL=
QR_SIGNING_SECRET=
RESEARCH_HASH_SALT=
QR_TOKEN_TTL_SECONDS=45
RULE_VERSION=ACTIVA-RULES-0.2.0
REVIEW_TARGET_HOURS=24
ALLOWED_ORIGINS=https://supparang.github.io
ACTIVA_AUTH_MODE=GOOGLE_OIDC
GOOGLE_CLIENT_ID=517090311491-u00q8g6aonuj2251ak7erqcose70gg2h.apps.googleusercontent.com
# Provisional approved Workspace domain; verify using the actual account before access testing.
GOOGLE_ALLOWED_DOMAINS=chandra.ac.th
# Leave disabled throughout deployment and acceptance. This task does not authorize GO.
ACTIVA_PRODUCTION_GO_ENABLED=false
