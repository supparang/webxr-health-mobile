rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function sessionDoc() {
      return get(/databases/$(database)/documents/ewp_player_sessions/$(request.auth.uid));
    }

    function owns(playerId) {
      return signedIn()
        && exists(/databases/$(database)/documents/ewp_player_sessions/$(request.auth.uid))
        && sessionDoc().data.playerId == playerId;
    }

    function activeProfile(playerId) {
      return exists(/databases/$(database)/documents/ewp_profiles/$(playerId))
        && get(/databases/$(database)/documents/ewp_profiles/$(playerId)).data.active == true;
    }

    function qaId(playerId) {
      return playerId.matches('^(QA|TEST)[-_].*') || playerId.matches('^99[0-9]{4,}$');
    }

    match /ewp_profiles/{playerId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && qaId(playerId)
        && request.resource.data.playerId == playerId
        && request.resource.data.active == true;
      allow update: if owns(playerId)
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastSeenAt', 'updatedAt']);
      allow delete: if false;
    }

    match /ewp_player_sessions/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && activeProfile(request.resource.data.playerId);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /ewp_progress/{playerId} {
      allow get: if owns(playerId);
      allow create: if owns(playerId)
        && request.resource.data.playerId == playerId;
      allow update: if owns(playerId)
        && request.resource.data.playerId == resource.data.playerId;
      allow delete: if false;
    }

    match /ewp_assignments/{playerId} {
      allow get: if owns(playerId);
      allow create: if owns(playerId)
        && request.resource.data.playerId == playerId;
      allow update, delete: if false;
    }

    match /ewp_assessments/{receiptId} {
      allow create: if owns(request.resource.data.playerId);
      allow get: if owns(resource.data.playerId);
      allow list, update, delete: if false;
    }

    match /ewp_game_results/{receiptId} {
      allow create: if owns(request.resource.data.playerId);
      allow get: if owns(resource.data.playerId);
      allow list, update, delete: if false;
    }

    match /ewp_game_summary/{playerId} {
      allow get, create, update: if owns(playerId)
        && request.resource.data.playerId == playerId;
      allow list, delete: if false;
    }

    match /ewp_events/{eventId} {
      allow create: if owns(request.resource.data.playerId);
      allow get: if owns(resource.data.playerId);
      allow list, update, delete: if false;
    }

    match /ewp_certificates/{playerId} {
      allow get, create, update: if owns(playerId)
        && request.resource.data.playerId == playerId;
      allow list, delete: if false;
    }

    match /ewp_assessment_checkpoints/{checkpointId} {
      allow get, create, update, delete: if signedIn()
        && request.resource.data.playerId is string
        && owns(request.resource.data.playerId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
