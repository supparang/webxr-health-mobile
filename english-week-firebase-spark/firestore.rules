rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 2026-08-09 Journey analytics redeploy marker R2.
    // Owned list/query access below is intentionally scoped to the playerId
    // claimed by the current anonymous-auth player session.
    function signedIn() { return request.auth != null; }
    function qaId(playerId) {
      return playerId.matches('^(QA|TEST)[-_].*') || playerId.matches('^99[0-9]{4,}$');
    }
    function sessionExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/ewp_player_sessions/$(request.auth.uid));
    }
    function sessionDoc() {
      return get(/databases/$(database)/documents/ewp_player_sessions/$(request.auth.uid));
    }
    function owns(playerId) {
      return signedIn() && sessionExists() && sessionDoc().data.playerId == playerId;
    }
    function ownsCheckpointId(checkpointId) {
      return signedIn() && sessionExists()
        && (checkpointId == sessionDoc().data.playerId + '__pre'
          || checkpointId == sessionDoc().data.playerId + '__post');
    }
    function activeProfile(playerId) {
      return exists(/databases/$(database)/documents/ewp_profiles/$(playerId))
        && get(/databases/$(database)/documents/ewp_profiles/$(playerId)).data.active == true;
    }

    match /ewp_profiles/{playerId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && qaId(playerId)
        && request.resource.data.playerId == playerId
        && request.resource.data.active == true;
      allow update: if owns(playerId)
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt', 'updatedAt']);
      allow delete: if false;
    }

    match /ewp_player_sessions/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.playerId is string
        && (qaId(request.resource.data.playerId) || activeProfile(request.resource.data.playerId));
      allow delete: if signedIn() && request.auth.uid == uid;
      allow list: if false;
    }

    match /ewp_progress/{playerId} {
      allow get: if owns(playerId);
      allow create: if owns(playerId) && request.resource.data.playerId == playerId;
      allow update: if owns(playerId) && request.resource.data.playerId == resource.data.playerId;
      allow delete, list: if false;
    }

    match /ewp_assignments/{playerId} {
      allow get: if owns(playerId);
      allow create: if owns(playerId) && request.resource.data.playerId == playerId;
      allow update, delete, list: if false;
    }

    match /ewp_assessments/{receiptId} {
      allow create: if request.resource.data.playerId is string && owns(request.resource.data.playerId);
      allow get: if owns(resource.data.playerId);
      allow list: if owns(resource.data.playerId);
      allow update, delete: if false;
    }

    match /ewp_game_results/{receiptId} {
      allow create: if request.resource.data.playerId is string && owns(request.resource.data.playerId);
      allow get: if owns(resource.data.playerId);
      allow list: if owns(resource.data.playerId);
      allow update, delete: if false;
    }

    match /ewp_game_summary/{playerId} {
      allow get: if owns(playerId);
      allow create: if owns(playerId) && request.resource.data.playerId == playerId;
      allow update: if owns(playerId) && request.resource.data.playerId == resource.data.playerId;
      allow list, delete: if false;
    }

    match /ewp_events/{eventId} {
      allow create: if request.resource.data.playerId is string && owns(request.resource.data.playerId);
      allow get: if owns(resource.data.playerId);
      allow list: if owns(resource.data.playerId);
      allow update, delete: if false;
    }

    match /ewp_certificates/{playerId} {
      allow get: if owns(playerId);
      allow create: if owns(playerId) && request.resource.data.playerId == playerId;
      allow update: if owns(playerId) && request.resource.data.playerId == resource.data.playerId;
      allow list, delete: if false;
    }

    match /ewp_assessment_checkpoints/{checkpointId} {
      allow get: if ownsCheckpointId(checkpointId);
      allow create: if ownsCheckpointId(checkpointId)
        && request.resource.data.playerId == sessionDoc().data.playerId;
      allow update: if ownsCheckpointId(checkpointId)
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.playerId == sessionDoc().data.playerId;
      allow delete: if ownsCheckpointId(checkpointId)
        && resource.data.playerId == sessionDoc().data.playerId;
      allow list: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
