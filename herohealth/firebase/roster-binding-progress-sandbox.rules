rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn() && request.auth.token.heroHealthTeacher == true;
    }

    function isTestStudent(studentId) {
      return studentId in ['990014', '990015', '990016', '990017'];
    }

    function isTestAssessmentDocument(documentId) {
      return documentId.matches('^(990014|990015|990016|990017)_.*$');
    }

    function assessmentWriterMatchesAuth() {
      return request.resource.data.firebaseSavedByUid == request.auth.uid
        || request.resource.data.createdByUid == request.auth.uid;
    }

    match /firebaseSmokeTests/{uid} {
      allow create, read, update, delete:
        if signedIn() && request.auth.uid == uid;
    }

    match /passportSandbox/{uid} {
      allow create, read, update, delete:
        if signedIn() && request.auth.uid == uid;
    }

    match /passportCrossDeviceSandbox/{studentId} {
      allow read: if signedIn() && (isTestStudent(studentId) || isTeacher());
      allow create, update:
        if signedIn() && isTestStudent(studentId);
      allow delete: if false;
    }

    // Sandbox roster is seeded only by Firebase Admin SDK.
    match /studentsSandbox/{studentId} {
      allow read: if signedIn() && (isTestStudent(studentId) || isTeacher());
      allow write: if false;
    }

    // Each anonymous UID owns its binding; teachers may read for audit.
    match /studentBindingsSandbox/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && isTestStudent(request.resource.data.studentId);
      allow delete: if false;
    }

    match /studentProgressSandbox/{studentId} {
      allow read: if signedIn() && (isTestStudent(studentId) || isTeacher());
      allow create, update: if signedIn()
        && isTestStudent(studentId)
        && request.resource.data.studentId == studentId;
      allow delete: if false;
    }

    match /studentAssessmentsSandbox/{documentId} {
      allow read: if signedIn() && (isTestAssessmentDocument(documentId) || isTeacher());
      allow create, update: if signedIn()
        && isTestAssessmentDocument(documentId)
        && isTestStudent(request.resource.data.studentId)
        && request.resource.data.completed == true
        && assessmentWriterMatchesAuth();
      allow delete: if false;
    }

    // Production collections remain teacher-readable only in this sandbox ruleset.
    match /students/{studentId} {
      allow read: if isTeacher();
      allow write: if false;
    }

    match /studentProgress/{studentId} {
      allow read: if isTeacher();
      allow write: if false;
    }

    match /studentAssessments/{documentId} {
      allow read: if isTeacher();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}