rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTestStudent(studentId) {
      return studentId == '990014';
    }

    function isTestAssessmentDocument(documentId) {
      return documentId.matches('^990014_.*$');
    }

    match /firebaseSmokeTests/{uid} {
      allow create, read, update, delete:
        if signedIn() && request.auth.uid == uid;
    }

    match /passportSandbox/{uid} {
      allow create, read, update, delete:
        if signedIn() && request.auth.uid == uid;
    }

    match /passportCrossDeviceSandbox/{studentId} {
      allow read, create, update:
        if signedIn() && isTestStudent(studentId);
      allow delete: if false;
    }

    // Roster is read-only from the web client. It can be seeded manually for sandbox.
    match /studentsSandbox/{studentId} {
      allow read: if signedIn() && isTestStudent(studentId);
      allow write: if false;
    }

    // Each anonymous UID may own only its own binding document.
    match /studentBindingsSandbox/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.studentId == '990014';
      allow delete: if false;
    }

    // Sandbox progress is restricted to the single synthetic test student.
    match /studentProgressSandbox/{studentId} {
      allow read: if signedIn() && isTestStudent(studentId);
      allow create, update: if signedIn()
        && isTestStudent(studentId)
        && request.resource.data.studentId == '990014';
      allow delete: if false;
    }

    // Assessment attempt and receipt documents for the synthetic sandbox student.
    // Document IDs must be in the form 990014_<attemptId> and the stored payload
    // must remain bound to studentId 990014.
    match /studentAssessmentsSandbox/{documentId} {
      allow read: if signedIn() && isTestAssessmentDocument(documentId);
      allow create, update: if signedIn()
        && isTestAssessmentDocument(documentId)
        && request.resource.data.studentId == '990014'
        && request.resource.data.completed == true
        && request.resource.data.firebaseSavedByUid == request.auth.uid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
