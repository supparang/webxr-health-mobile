rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Existing isolated smoke tests.
    match /firebaseSmokeTests/{uid} {
      allow create, read, update, delete:
        if request.auth != null && request.auth.uid == uid;
    }

    match /passportSandbox/{uid} {
      allow create, read, update, delete:
        if request.auth != null && request.auth.uid == uid;
    }

    // Cross-device sandbox: ONLY the synthetic test student 990014.
    // This deliberately proves studentId-based recovery but is NOT a production rule.
    match /passportCrossDeviceSandbox/{studentId} {
      allow read, create, update:
        if request.auth != null
        && studentId == '990014'
        && (
          request.method == 'get'
          || request.resource.data.studentId == '990014'
        );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
